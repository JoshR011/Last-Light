.door-prompt {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 55%;
    align-items: center;
}

.door-prompt__panel {
    width: 222px;
    align-items: stretch;
    padding-top: 9px;
    padding-right: 16px;
    padding-bottom: 11px;
    padding-left: 16px;
    background-color: rgba(15, 18, 21, 0.88);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.door-prompt__label {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(249, 245, 233);
    margin-bottom: 7px;
}

.door-prompt__track {
    height: 5px;
    background-color: rgb(72, 77, 79);
}

.door-prompt__fill {
    width: 0%;
    height: 100%;
    background-color: rgb(241, 191, 105);
}
